# Copy this file to .env and fill in real values. NEVER commit the real .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/studyguard?schema=public"

# Long random string used to sign JWTs - generate with: openssl rand -hex 32
JWT_SECRET="replace_with_a_long_random_secret"

# ---------------------------------------------------------------------------
# LLM PROVIDER
# ---------------------------------------------------------------------------
# Which LLM backend to use: "xai" (Grok, default) or "anthropic" (Claude).
LLM_PROVIDER="xai"

# xAI / Grok - get a key at https://console.x.ai (Billing -> API Keys).
# Model list: https://docs.x.ai/docs/models  (e.g. grok-3, grok-3-mini, grok-4)
XAI_API_KEY="xai-your-key-here"
XAI_MODEL="grok-3"
# XAI_BASE_URL="https://api.x.ai/v1"   # only override for a proxy/gateway

# Anthropic Claude - only needed if LLM_PROVIDER="anthropic".
# ANTHROPIC_API_KEY="sk-ant-your-key-here"
# ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Used to validate university email addresses at signup (Section 6)
UNIVERSITY_EMAIL_DOMAIN="uiu.ac.bd"

# Frontend origin allowed by CORS (comma-separated for multiple)
FRONTEND_ORIGIN="http://localhost:3000"

PORT=4000
NODE_ENV=development
