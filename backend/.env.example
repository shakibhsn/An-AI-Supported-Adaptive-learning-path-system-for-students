# Copy this file to .env and fill in real values. NEVER commit the real .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/adaptive_learning_path?schema=public"

# Long random string used to sign JWTs - generate with: openssl rand -hex 32
JWT_SECRET="replace_with_a_long_random_secret"

# Anthropic API key - get one at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# Used to validate university email addresses at signup (Section 6)
UNIVERSITY_EMAIL_DOMAIN="uiu.ac.bd"

PORT=4000
NODE_ENV=development
