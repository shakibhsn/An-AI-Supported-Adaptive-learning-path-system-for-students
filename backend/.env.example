# Copy this file to .env and fill in real values. NEVER commit the real .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/studyguard?schema=public"

# Long random string used to sign JWTs - generate with: openssl rand -hex 32
JWT_SECRET="replace_with_a_long_random_secret"

# ---------------------------------------------------------------------------
# LLM PROVIDER
# ---------------------------------------------------------------------------
# "xai"       -> OpenAI-compatible REST (drives xAI/Grok OR Groq OR any
#                OpenAI-compatible gateway - just change XAI_BASE_URL + XAI_MODEL)
# "anthropic" -> Anthropic Claude via the official SDK
LLM_PROVIDER="xai"

# --- Option A: Groq (free tier) --- https://console.groq.com  (Keys)
XAI_API_KEY="gsk_your-groq-key-here"
XAI_BASE_URL="https://api.groq.com/openai/v1"
XAI_MODEL="openai/gpt-oss-120b"
# check available models:  curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $XAI_API_KEY"

# --- Option B: xAI / Grok (paid) --- https://console.x.ai  (Billing -> API Keys)
# XAI_API_KEY="xai-your-key-here"
# XAI_BASE_URL="https://api.x.ai/v1"
# XAI_MODEL="grok-3"

# --- Option C: Anthropic Claude --- set LLM_PROVIDER="anthropic"
# ANTHROPIC_API_KEY="sk-ant-your-key-here"
# ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Used to validate university email addresses at signup (Section 6)
UNIVERSITY_EMAIL_DOMAIN="uiu.ac.bd"

# Frontend origin allowed by CORS (comma-separated for multiple)
FRONTEND_ORIGIN="http://localhost:3000"

PORT=4000
NODE_ENV=development
