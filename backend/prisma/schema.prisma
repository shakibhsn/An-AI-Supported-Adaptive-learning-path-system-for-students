// An AI-Supported Adaptive Learning Path System for Students database schema.
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  studentId    String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diagnosticAttempts       DiagnosticAttempt[]
  topicMastery             TopicMastery[]
  learningPaths            LearningPath[]
  practiceAttempts         PracticeAttempt[]
  followUpAttempts         FollowUpAttempt[]
  aiInteractions           AIInteraction[]
  materialCompletions      MaterialCompletion[]
  practiceQuestionAttempts PracticeQuestionAttempt[]
  learningActivities       LearningActivity[]
  assessmentAttempts       AssessmentAttempt[]

  @@index([email])
}

model Course {
  id          String  @id @default(cuid())
  code        String  @unique // "DSA" | "OOP" | "SPL"
  name        String
  description String?

  topics              Topic[]
  diagnosticQuestions DiagnosticQuestion[]
  practiceQuestions   PracticeQuestion[]
  diagnosticAttempts  DiagnosticAttempt[]
  topicMastery        TopicMastery[]
  learningPaths       LearningPath[]
  practiceAttempts    PracticeAttempt[]
  followUpAttempts    FollowUpAttempt[]
  aiInteractions      AIInteraction[]
  learningMaterials   LearningMaterial[]
  learningActivities  LearningActivity[]
  assessmentAttempts  AssessmentAttempt[]
}

model Topic {
  id                  String  @id @default(cuid())
  courseId            String
  name                String
  description         String?
  prerequisiteTopicId String?

  course       Course  @relation(fields: [courseId], references: [id])
  prerequisite Topic?  @relation("TopicPrerequisite", fields: [prerequisiteTopicId], references: [id])
  dependents   Topic[] @relation("TopicPrerequisite")

  diagnosticQuestions      DiagnosticQuestion[]
  practiceQuestions        PracticeQuestion[]
  diagnosticAnswers        DiagnosticAnswer[]
  topicMastery             TopicMastery[]
  learningPathItems        LearningPathItem[]
  practiceAttempts         PracticeAttempt[]
  followUpAttempts         FollowUpAttempt[]
  aiInteractions           AIInteraction[]
  learningMaterials        LearningMaterial[]
  practiceQuestionAttempts PracticeQuestionAttempt[]
  learningActivities       LearningActivity[]
  assessmentAttempts       AssessmentAttempt[]

  @@unique([courseId, name])
  @@index([courseId])
}

model DiagnosticQuestion {
  id            String @id @default(cuid())
  courseId      String
  topicId       String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String // "A" | "B" | "C" | "D"
  difficulty    String @default("MEDIUM") // "EASY" | "MEDIUM" | "HARD"

  course  Course             @relation(fields: [courseId], references: [id])
  topic   Topic              @relation(fields: [topicId], references: [id])
  answers DiagnosticAnswer[]

  @@index([courseId])
  @@index([topicId])
}

model DiagnosticAttempt {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  score          Int // total correct
  totalQuestions Int
  completedAt    DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id])
  course  Course             @relation(fields: [courseId], references: [id])
  answers DiagnosticAnswer[]

  @@index([userId, courseId])
}

model DiagnosticAnswer {
  id             String  @id @default(cuid())
  attemptId      String
  questionId     String
  topicId        String
  selectedAnswer String
  isCorrect      Boolean

  attempt  DiagnosticAttempt  @relation(fields: [attemptId], references: [id])
  question DiagnosticQuestion @relation(fields: [questionId], references: [id])
  topic    Topic              @relation(fields: [topicId], references: [id])

  @@index([attemptId])
}

model TopicMastery {
  id                 String   @id @default(cuid())
  userId             String
  courseId           String
  topicId            String
  masteryPercentage  Float
  previousPercentage Float?
  status             String // "Mastered" | "Developing" | "Needs Improvement" | "Weak/Critical"
  attempts           Int      @default(1)
  updatedAt          DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  topic  Topic  @relation(fields: [topicId], references: [id])

  @@unique([userId, topicId])
  @@index([userId, courseId])
}

model LearningPath {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  status    String   @default("active") // "active" | "superseded"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User               @relation(fields: [userId], references: [id])
  course Course             @relation(fields: [courseId], references: [id])
  items  LearningPathItem[]

  @@index([userId, courseId])
}

model LearningPathItem {
  id               String  @id @default(cuid())
  learningPathId   String
  topicId          String
  sequenceOrder    Int
  status           String  @default("pending") // "pending" | "in_progress" | "completed"
  isRevision       Boolean @default(false)
  estimatedMinutes Int

  learningPath LearningPath @relation(fields: [learningPathId], references: [id])
  topic        Topic        @relation(fields: [topicId], references: [id])

  @@index([learningPathId])
}

model PracticeQuestion {
  id            String  @id @default(cuid())
  courseId      String
  topicId       String
  question      String
  options       Json // [{ letter, text }]
  correctAnswer String
  explanation   String?
  // The spec's model list has FollowUpAttempt (a result) but no separate
  // follow-up QUESTION table. Follow-up questions are structurally
  // identical to practice questions (question/options/answer/explanation),
  // so this flag distinguishes the real follow-up questions (used only
  // by GET /api/courses/:id/follow-up) from the regular practice
  // questions, without inventing an unlisted table. Documented here and
  // in the README as an intentional, justified schema adaptation.
  isFollowUp    Boolean @default(false)
  difficulty    String  @default("MEDIUM") // "EASY" | "MEDIUM" | "HARD" - drives adaptive selection
  questionType  String  @default("MCQ") // "MCQ" | "TRUE_FALSE" | "CONCEPT" | "SCENARIO" | "CODE" | "SHORT_ANSWER" | "PROBLEM_SOLVING"

  // Randomized Adaptive Assessment fields (additive - null/default for every
  // pre-existing question, only populated for the new assessment question
  // bank). subtopic drives weak-area detection; expectedConcepts/
  // acceptableKeyPoints are the rubric an AI (or fallback keyword match)
  // evaluates SHORT_ANSWER/PROBLEM_SOLVING responses against.
  subtopic            String?
  expectedConcepts    Json? // string[]
  acceptableKeyPoints Json? // string[]
  maxScore            Int     @default(1)

  course   Course                    @relation(fields: [courseId], references: [id])
  topic    Topic                     @relation(fields: [topicId], references: [id])
  attempts PracticeQuestionAttempt[]

  @@index([courseId])
  @@index([topicId])
  @@index([topicId, isFollowUp, difficulty])
}

model PracticeAttempt {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  topicId        String
  score          Int
  totalQuestions Int
  completedAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  topic  Topic  @relation(fields: [topicId], references: [id])

  @@index([userId, courseId])
}

model FollowUpAttempt {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  topicId         String
  score           Int
  totalQuestions  Int
  previousMastery Float?
  newMastery      Float
  completedAt     DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  topic  Topic  @relation(fields: [topicId], references: [id])

  @@index([userId, courseId])
}

model AIInteraction {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  topicId         String?
  interactionType String // "personalize" | "chat"
  userMessage     String
  aiResponse      String
  createdAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  topic  Topic? @relation(fields: [topicId], references: [id])

  @@index([userId, courseId])
}

// Curated learning resources. The system is extensible by design: adding a
// resource = inserting a row (see prisma/seed.ts + src/data/learningMaterials.ts).
// Every topic can carry any number of materials of any type. The frontend
// loads whatever is active for a topic - no code change needed to add more.
model LearningMaterial {
  id              String   @id @default(cuid())
  courseId        String
  topicId         String
  title           String
  description     String?
  type            String // "VIDEO" | "PLAYLIST" | "ARTICLE" | "PRACTICE" | "DOCUMENT" | "OTHER"
  url             String
  provider        String? // e.g. "YouTube", "GeeksforGeeks", "MDN"
  difficulty      String   @default("BEGINNER") // "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
  durationMinutes Int?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course      Course               @relation(fields: [courseId], references: [id])
  topic       Topic                @relation(fields: [topicId], references: [id])
  completions MaterialCompletion[]
  activities  LearningActivity[]

  @@index([courseId])
  @@index([topicId, isActive])
}

// One row per individual practice-question response. PracticeAttempt (above)
// stays as the aggregate summary a submission produces; this is the
// per-question detail needed for adaptive difficulty selection (Section 9)
// and to avoid re-serving a question the student already answered correctly
// recently (Section 9/19).
model PracticeQuestionAttempt {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  topicId     String
  difficulty  String // snapshot of the question's difficulty at answer time
  isCorrect   Boolean
  attemptedAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id])
  question PracticeQuestion @relation(fields: [questionId], references: [id])
  topic    Topic            @relation(fields: [topicId], references: [id])

  @@index([userId, topicId, difficulty])
  @@index([questionId])
}

// Real, event-based learning-activity tracking (Section 2/3/4). Each row is
// one continuous span of active engagement - the frontend starts a span when
// an activity begins, pauses it on tab-hidden, resumes on tab-visible, and
// flushes durationSeconds when the activity ends or the page unloads. No
// countdown timer, no guessed durations - see LearningActivity docs.
model LearningActivity {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  topicId         String?
  materialId      String?
  activityType    String // "MATERIAL_VIEW" | "READING" | "PRACTICE" | "QUIZ" | "AI_INTERACTION"
  source          String    @default("in_app") // "in_app" | "external" - Section 5: never conflate the two
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  createdAt       DateTime  @default(now())

  user     User              @relation(fields: [userId], references: [id])
  course   Course            @relation(fields: [courseId], references: [id])
  topic    Topic?            @relation(fields: [topicId], references: [id])
  material LearningMaterial? @relation(fields: [materialId], references: [id])

  @@index([userId, courseId, createdAt])
  @@index([userId, topicId])
}

// A student marking a material as completed. Feeds the progress dashboard
// (Section 22: "completed learning materials") and material-completion state
// in the learning path UI.
model MaterialCompletion {
  id          String   @id @default(cuid())
  userId      String
  materialId  String
  completedAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id])
  material LearningMaterial @relation(fields: [materialId], references: [id])

  @@unique([userId, materialId])
  @@index([userId])
}

// Randomized Adaptive Assessment (Easy -> Medium -> Hard, level-locked).
// One row per assessment attempt. questionIds is the exact, already-shuffled
// set persisted at start time so a page refresh resumes the SAME questions
// (spec requirement) instead of re-rolling a new random set; a new attempt
// is only created when the student explicitly starts a new one. answers +
// subtopicBreakdown are filled in at submit time from real scored responses -
// never fabricated. This is deliberately a separate, additive model from
// PracticeAttempt (which stays exactly as-is for the existing rolling-window
// adaptive practice feature) so neither system disturbs the other.
model AssessmentAttempt {
  id                String    @id @default(cuid())
  userId            String
  courseId          String
  topicId           String
  difficulty        String // "EASY" | "MEDIUM" | "HARD"
  questionIds       Json // string[] in the fixed, shuffled serving order
  // Frozen, per-attempt snapshot of exactly what was served: for MCQ this
  // includes the RE-SHUFFLED options and the correctAnswer letter matching
  // that shuffle (shuffling relabels A/B/C/D - see assessment.service.ts
  // shuffleOptions). Grading and a refresh-resume must both use this EXACT
  // snapshot, never the live PracticeQuestion row, or a shuffled serving
  // would be graded against the wrong (original, unshuffled) letter.
  servedQuestions   Json?
  status            String    @default("in_progress") // "in_progress" | "completed"
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  score             Float? // marks obtained
  maxScore          Float? // marks possible
  percentage        Float?
  answers           Json? // per-question submitted answer + correctness/eval, keyed by questionId
  subtopicBreakdown Json? // { [subtopic]: { correct, total, percentage } }
  createdAt         DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  topic  Topic  @relation(fields: [topicId], references: [id])

  @@index([userId, topicId, difficulty, status])
}
